@page "/settings"
@using KnowledgeMediaImporter.Configuration


<PageTitle>rAIce - Settings</PageTitle>

@if (_serviceSettings != null)
{
    <MudExObjectEditForm ShowCancelButton="false" T="ServiceSettings" OnValidSubmit="@SaveSettingsAsync" Value="_serviceSettings">
        <ToolBarContent>
            <MudIconButton Disabled="@(!File.Exists(UserSettingsFile))" OnClick="@DeleteAsync" Icon="@Icons.Material.Filled.Delete" Title="Delete custom and restore factory defaults"></MudIconButton>
        </ToolBarContent>
    </MudExObjectEditForm>
}