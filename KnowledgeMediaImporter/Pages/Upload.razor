@page "/upload"
@using KnowledgeMedia.Core

<PageTitle>rAIce - Upload</PageTitle>

<MudText Typo="Typo.h4" Color="Color.Primary">Upload file to create Knowledge Article</MudText>

<MudButton Class="m-5" Variant="Variant.Filled" Disabled="@_running" Color="Color.Primary" OnClick="@UploadClick">Upload File</MudButton>

@if(_running){
    <MudText>@ProgressText</MudText>
    <MudProgressLinear Color="Color.Secondary" Value="@ProgressValue" Class="my-7" />
}
